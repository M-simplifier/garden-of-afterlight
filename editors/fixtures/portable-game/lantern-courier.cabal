cabal-version: 3.0
name: lantern-courier
version: 0.1.0.0
build-type: Simple

library
  hs-source-dirs: engine
  exposed-modules: Lantern.Types, Lantern.Rules
  build-depends: base >=4.18 && <4.19, containers
  default-language: GHC2021

executable courier
  hs-source-dirs: desktop
  main-is: Main.hs
  build-depends: base, lantern-courier
  default-language: GHC2021

test-suite rules
  type: exitcode-stdio-1.0
  hs-source-dirs: checks
  main-is: RulesSpec.hs
  build-depends: base, lantern-courier
  default-language: GHC2021
